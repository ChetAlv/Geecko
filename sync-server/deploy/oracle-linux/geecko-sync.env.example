# Este archivo se instala como /etc/geecko-sync/geecko-sync.env.
# Si la contraseña contiene @, :, /, #, ? o %, codifícala para una URL.
# Para PostgreSQL remoto usa sslmode=require o el modo exigido por tu proveedor.
DATABASE_URL='postgresql://geecko_sync:CAMBIAR_CONTRASENA@127.0.0.1:5432/geecko'

# Nginx es el único proceso público. No cambies esto a 0.0.0.0 en producción.
GEECKO_SYNC_BIND=127.0.0.1:8787

# Actívalo temporalmente sólo para investigar un fallo inesperado.
RUST_BACKTRACE=0
